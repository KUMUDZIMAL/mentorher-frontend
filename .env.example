# ---------------------------------------------------------------------------
# MentorHer frontend — copy to ".env.local" and edit for plain dev.
#
#   cp .env.example .env.local
#
# For Docker Compose the NEXT_PUBLIC_* values are supplied as BUILD ARGS from
# mentorher-backend/.env instead (they are inlined into the client bundle at
# build time, so changing them requires a rebuild).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
